# Copy this file to srcs/.env (done automatically by `make init`) and adjust
# if needed. Nothing here is secret: real passwords live in secrets/, never here.

# --- domain -------------------------------------------------------------
DOMAIN_NAME=egokce.42.fr

# --- mariadb --------------------------------------------------------------
# Database used by WordPress, and the one non-root user that owns it.
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user

# --- wordpress --------------------------------------------------------------
WP_TITLE=Inception

# Admin account. Subject forbids "admin"/"administrator" (any case) in this
# username, so pick something else.
WP_ADMIN_USER=egokce_owner
WP_ADMIN_EMAIL=egokce_owner@egokce.42.fr

# Second, non-administrator WordPress user (subject requires at least two users).
WP_USER=editor_eg
WP_USER_EMAIL=editor_eg@egokce.42.fr
WP_USER_ROLE=editor
